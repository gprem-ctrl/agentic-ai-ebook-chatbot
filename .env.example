# --- Pinecone (vector DB) ---
# Free tier: https://app.pinecone.io
PINECONE_API_KEY=
PINECONE_INDEX_NAME=agentic-ai-ebook
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Groq (LLM for generation) ---
# Free tier: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL_NAME=openai/gpt-oss-20b

# --- Embeddings (local, no API key) ---
# If you change the model, set EMBEDDING_DIM to match and re-ingest with --reset.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- Chunking (CHUNK_OVERLAP must be smaller than CHUNK_SIZE) ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Source document (defaults already point to the assigned eBook) ---
PDF_URL=https://konverge.ai/pdf/Ebook-Agentic-AI.pdf
PDF_LOCAL_PATH=data/Ebook-Agentic-AI.pdf

# --- Retrieval tuning ---
TOP_K=8
MIN_CONFIDENCE_THRESHOLD=0.35
